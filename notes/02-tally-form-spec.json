{
  "formTitle": "Wear Your Healing — Bestellung",
  "blocks": [
    {
      "title": "Persönliches",
      "fields": [
        { "name": "name", "label": "Vor- und Nachname", "type": "short_text", "required": true },
        { "name": "email", "label": "E-Mail-Adresse", "type": "email", "required": true },
        { "name": "telefon", "label": "Telefonnummer", "type": "phone", "required": false }
      ]
    },
    {
      "title": "Lieferadresse",
      "fields": [
        { "name": "strasse", "label": "Straße + Hausnummer", "type": "short_text", "required": true },
        { "name": "plz", "label": "PLZ", "type": "short_text", "required": true },
        { "name": "ort", "label": "Ort", "type": "short_text", "required": true },
        { "name": "land", "label": "Land", "type": "dropdown", "required": true, "options": ["Deutschland", "Österreich", "Schweiz", "Sonstiges"] }
      ]
    },
    {
      "title": "Deine Bestellung",
      "fields": [
        {
          "name": "charm_typ",
          "label": "Charm-Typ",
          "type": "multiple_choice_single",
          "required": true,
          "options": ["Mini-Charm (10 €)", "Ketten-Charm (11 €)", "Schlüssel-Charm (12 €)"]
        },
        {
          "name": "schmuckstueck",
          "label": "Mit Schmuckstück?",
          "type": "multiple_choice_single",
          "required": true,
          "options": ["Nur Charm", "Mit Armkette (+14 €)", "Mit Halskette (+18 €)"]
        },
        {
          "name": "farbe",
          "label": "Welche Farbe?",
          "type": "multiple_choice_single",
          "required": true,
          "options": ["Gold", "Silber", "Rosé"]
        },
        {
          "name": "groesse",
          "label": "Welche Größe?",
          "type": "multiple_choice_single",
          "required": true,
          "options": ["Klein (ca. 1,8 cm)", "Mittel (ca. 2,0 cm)", "Groß (ca. 2,2 cm)"]
        },
        {
          "name": "lebensmittel",
          "label": "Welches Lebensmittel oder Wort soll auf dem Charm sein?",
          "type": "short_text",
          "required": true
        }
      ]
    },
    {
      "title": "Deine Geschichte",
      "fields": [
        {
          "name": "geschichte",
          "label": "Hat dein Charm eine Geschichte? Magst du sie mit mir teilen?",
          "type": "long_text",
          "required": false
        },
        {
          "name": "geschichte_teilen",
          "label": "Darf Julia deine Geschichte anonym auf Social Media teilen?",
          "type": "multiple_choice_single",
          "required": true,
          "options": ["Ja, gerne anonym", "Nein, lieber nicht"],
          "default": "Nein, lieber nicht",
          "conditional": { "show_when": "geschichte", "is": "not_empty" }
        }
      ]
    },
    {
      "title": "Social Media",
      "fields": [
        {
          "name": "video_erlaubnis",
          "label": "Darf Julia ein Video vom Designprozess deines Charms auf Social Media posten?",
          "type": "multiple_choice_single",
          "required": true,
          "options": ["Ja, gerne", "Nein, lieber nicht"],
          "default": "Nein, lieber nicht"
        }
      ]
    },
    {
      "title": "Zahlungsmethode",
      "fields": [
        {
          "name": "zahlung",
          "label": "Wie möchtest du bezahlen?",
          "type": "multiple_choice_single",
          "required": true,
          "options": ["Vorkasse per Überweisung (empfohlen, einfachste Variante)", "PayPal"]
        }
      ]
    },
    {
      "title": "Bemerkung",
      "fields": [
        {
          "name": "bemerkung",
          "label": "Möchtest du mir noch etwas mitteilen?",
          "type": "long_text",
          "required": false
        }
      ]
    },
    {
      "title": "Pflichtabfragen",
      "fields": [
        {
          "name": "datenschutz",
          "label": "Ich habe die Datenschutzerklärung gelesen und stimme zu",
          "type": "checkbox",
          "required": true
        },
        {
          "name": "zahlungshinweis",
          "label": "Ich habe die Hinweise zur Bezahlung gelesen und verstehe, dass bei Vorkasse erst nach Zahlungseingang produziert und versendet wird",
          "type": "checkbox",
          "required": true
        }
      ]
    }
  ],
  "settings": {
    "confirmation_email": {
      "enabled": true,
      "subject": "Deine Bestellung bei Wear Your Healing",
      "recipient_field": "email"
    },
    "notification_email": {
      "enabled": true,
      "to": "julia@bergles.net"
    },
    "region": "EU",
    "redirect_after_submit": null
  }
}
